# Giscus (https://giscus.app) — enable GitHub Discussions on the repo first, then copy IDs here.
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ExoClick — sticky left vertical banner on lg+ screens. Set false to disable.
# NEXT_PUBLIC_EXOCLICK_ENABLED=false
# NEXT_PUBLIC_EXOCLICK_LEFT_ZONE_ID=5967806
# NEXT_PUBLIC_EXOCLICK_LEFT_CLASS=eas6a97888e17

# Adsterra — set NEXT_PUBLIC_ADSTERRA_ENABLED=false to disable. Sizes optional.
NEXT_PUBLIC_ADSTERRA_ENABLED=false
NEXT_PUBLIC_ADSTERRA_SCRIPT_HOST=www.highperformanceformat.com
# NEXT_PUBLIC_ADSTERRA_SIDE_WIDTH=160
# NEXT_PUBLIC_ADSTERRA_SIDE_HEIGHT=600
# NEXT_PUBLIC_ADSTERRA_BOTTOM_PHONE_WIDTH=320
# NEXT_PUBLIC_ADSTERRA_BOTTOM_PHONE_HEIGHT=50
# NEXT_PUBLIC_ADSTERRA_BOTTOM_SMALL_TABLET_WIDTH=468
# NEXT_PUBLIC_ADSTERRA_BOTTOM_SMALL_TABLET_HEIGHT=60
# NEXT_PUBLIC_ADSTERRA_BOTTOM_TABLET_WIDTH=728
# NEXT_PUBLIC_ADSTERRA_BOTTOM_TABLET_HEIGHT=90
