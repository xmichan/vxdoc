# Giscus (https://giscus.app) — enable GitHub Discussions on the repo first, then copy IDs here.
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=General
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Adsterra — set NEXT_PUBLIC_ADSTERRA_ENABLED=false to disable. Sizes optional.
NEXT_PUBLIC_ADSTERRA_ENABLED=true
NEXT_PUBLIC_ADSTERRA_SCRIPT_HOST=www.highperformanceformat.com
